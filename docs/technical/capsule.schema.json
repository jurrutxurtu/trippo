    "ActivityStats": {
      "additionalProperties": false,
      "description": "Telemetry. Lives ONLY on track-bearing activity events -- never on a trip.\n\nAscent and descent use ELEVATION_THRESHOLD_M; without it GPS noise reports\n+1,400 m on a flat ride.",
