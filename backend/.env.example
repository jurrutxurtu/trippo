# Copy to .env. Never commit the real file.
MAPTILER_KEY=

# --- language model ---------------------------------------------------------
# Tried in order; the first that answers is used.  Check with:
#   python -m trippo.cli ai-check
LLM_ORDER=gemini,groq

# Google. A Google AI Pro subscription does NOT cover the API -- billed separately.
GEMINI_API_KEY=
GEMINI_MODEL=

# Groq. Free tier, no card required: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=

# Paid, off by default. See docs/decisions/ADR-0010.
GOOGLE_PLACES_API_KEY=
